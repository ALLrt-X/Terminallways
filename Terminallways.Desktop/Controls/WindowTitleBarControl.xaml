<UserControl x:Class="Terminallways.Desktop.Controls.WindowTitleBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="32">
    <UserControl.Resources>
        <!-- Базовый стиль кнопок управления окном -->
        <!-- Важно: WindowChrome.IsHitTestVisibleInChrome="True" делает кнопку кликабельной внутри зоны перетаскивания -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9AA8BD"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252D3F"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#313C54"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Отдельный стиль для кнопки закрытия (красная подсветка) -->
        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#551CC4"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44169E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#131722" BorderBrush="#22293A" BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть: логотип/название -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,10,0">
                <Border Width="8" Height="8" CornerRadius="2" Background="#3B82F6" Margin="0,0,8,0"/>
                <TextBlock x:Name="TitleText"
                           Text="TERMINALLWAYS"
                           Foreground="#CBD5E1"
                           FontFamily="Consolas"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Центральная зона: свободное место под перетаскивание + слот под будущие декали/кнопки -->
            <!-- Примечание на будущее: любым кликабельным кнопкам внутри ставь WindowChrome.IsHitTestVisibleInChrome="True" -->
            <StackPanel x:Name="DecalsSlot"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"/>

            <!-- Правая часть: кастомные кнопки Свернуть / Развернуть / Закрыть -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource TitleBarButtonStyle}"
                        ToolTip="Свернуть"
                        Click="BtnMinimize_Click">
                    <Path Data="M 0,5.5 L 10,5.5"
                          Width="10" Height="10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1"
                          SnapsToDevicePixels="True"/>
                </Button>

                <Button x:Name="BtnMaximize"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTip="Развернуть"
                        Click="BtnMaximize_Click">
                    <Grid Width="10" Height="10">
                        <!-- Иконка «Развернуть» -->
                        <Path x:Name="IconMaximize"
                              Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"
                              SnapsToDevicePixels="True"/>
                        <!-- Иконка «Восстановить» (два квадрата) -->
                        <Path x:Name="IconRestore"
                              Visibility="Collapsed"
                              Data="M 2.5,2.5 L 2.5,0.5 L 9.5,0.5 L 9.5,7.5 L 7.5,7.5 M 0.5,2.5 L 7.5,2.5 L 7.5,9.5 L 0.5,9.5 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"
                              SnapsToDevicePixels="True"/>
                    </Grid>
                </Button>

                <Button Style="{StaticResource TitleBarCloseButtonStyle}"
                        ToolTip="Закрыть"
                        Click="BtnClose_Click">
                    <Path Data="M 1,1 L 9,9 M 9,1 L 1,9"
                          Width="10" Height="10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.1"
                          SnapsToDevicePixels="True"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>